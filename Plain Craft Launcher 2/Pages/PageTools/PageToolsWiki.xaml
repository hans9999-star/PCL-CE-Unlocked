<local:MyPageRight x:Class="PCL.PageToolsWiki"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:local="clr-namespace:PCL">
    <Grid Margin="25,20,25,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ 顶部搜索条 ═══ -->
        <local:MyCard Grid.Row="0" Margin="0,0,0,12">
            <Grid Margin="20,14,20,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{DynamicResource Tools.Wiki.TitleShort}"
                           FontSize="18" FontWeight="Bold" VerticalAlignment="Center"
                           Margin="0,0,16,0" />

                <local:MyTextBox x:Name="TextSearch" Grid.Column="1"
                                 HintText="{DynamicResource Tools.Wiki.SearchHint}"
                                 KeyDown="TextSearch_KeyDown" />

                <local:MyButton x:Name="BtnSearch" Grid.Column="2" Margin="10,0,0,0"
                                MinWidth="88" Padding="16,6" ColorType="Highlight"
                                Text="{DynamicResource Tools.Wiki.Search}"
                                Click="BtnSearch_Click" />
            </Grid>
        </local:MyCard>

        <!-- ═══ 视图 A：搜索结果（占满整页）═══ -->
        <local:MyCard Grid.Row="1" x:Name="CardResult">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <WrapPanel x:Name="PanSuggest" Grid.Row="0" Margin="20,16,20,4" />

                <local:MyScrollViewer Grid.Row="1" x:Name="PanResultScroll"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      DeltaMult="0.7">
                    <StackPanel x:Name="PanItems" Margin="20,8,20,14" />
                </local:MyScrollViewer>

                <StackPanel x:Name="PanStatus" Grid.Row="1"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="20,0,20,30">
                    <TextBlock x:Name="LabStatusTitle"
                               HorizontalAlignment="Center" FontSize="15"
                               Opacity="0.5" TextWrapping="Wrap" TextAlignment="Center"
                               Text="{DynamicResource Tools.Wiki.Empty.Title}" />
                    <TextBlock x:Name="LabStatusDesc"
                               HorizontalAlignment="Center" FontSize="12"
                               Opacity="0.38" TextWrapping="Wrap" TextAlignment="Center"
                               MaxWidth="420" Margin="0,8,0,0"
                               Text="{DynamicResource Tools.Wiki.Empty.Description}" />
                    <local:MyLoading x:Name="Load" Margin="0,16,0,0"
                                     HorizontalAlignment="Center"
                                     Text="{DynamicResource Tools.Wiki.Searching}"
                                     Visibility="Collapsed" />
                </StackPanel>

                <TextBlock x:Name="LabCount" Grid.Row="2" FontSize="11" Opacity="0.45"
                           Margin="22,0,20,12" />
            </Grid>
        </local:MyCard>

        <!-- ═══ 视图 B：条目内容（占满整页）═══ -->
        <local:MyCard Grid.Row="1" x:Name="CardBrowser" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16,12,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 返回搜索结果 -->
                    <local:MyButton x:Name="BtnReturn" Grid.Column="0" MinWidth="88" Padding="12,4"
                                    Margin="0,0,10,0"
                                    Text="{DynamicResource Tools.Wiki.Return}"
                                    Click="BtnReturn_Click" />

                    <local:MyIconButton x:Name="BtnBack" Grid.Column="1" Height="28" Width="28"
                                        VerticalAlignment="Center" Theme="White"
                                        ToolTip="{DynamicResource Tools.Wiki.Back}"
                                        Click="BtnBack_Click"
                                        SvgIcon="lucide/arrow-left" />
                    <local:MyIconButton x:Name="BtnForward" Grid.Column="2" Height="28" Width="28"
                                        VerticalAlignment="Center" Theme="White" Margin="4,0,0,0"
                                        ToolTip="{DynamicResource Tools.Wiki.Forward}"
                                        Click="BtnForward_Click"
                                        SvgIcon="lucide/arrow-right" />
                    <local:MyIconButton x:Name="BtnReload" Grid.Column="3" Height="28" Width="28"
                                        VerticalAlignment="Center" Theme="White" Margin="4,0,0,0"
                                        ToolTip="{DynamicResource Tools.Wiki.Reload}"
                                        Click="BtnReload_Click"
                                        SvgIcon="lucide/arrow-up-down" />

                    <Border Grid.Column="4" Margin="10,0,10,0" CornerRadius="4"
                            Background="{DynamicResource ColorBrushGray8}" Padding="10,4,10,4">
                        <TextBlock x:Name="LabUrl" FontSize="12" Opacity="0.55"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Border>

                    <local:MyIconButton x:Name="BtnCompact" Grid.Column="5" Height="28" Width="28"
                                        VerticalAlignment="Center" Theme="White" Margin="0,0,8,0"
                                        ToolTip="{DynamicResource Tools.Wiki.Compact.On}"
                                        Click="BtnCompact_Click"
                                        SvgIcon="lucide/layout-list" />

                    <local:MyButton x:Name="BtnExternal" Grid.Column="6" MinWidth="96" Padding="12,4"
                                    Text="{DynamicResource Tools.Wiki.External}"
                                    Click="BtnExternal_Click" />
                </Grid>
                <Grid Grid.Row="1" ClipToBounds="True">

                    <!-- 空状态：还没打开任何条目 -->
                    <StackPanel x:Name="PanWebEmpty" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Margin="30,0,30,0">
                        <TextBlock Text="{DynamicResource Tools.Wiki.OpenHint}"
                                   HorizontalAlignment="Center" FontSize="14"
                                   Opacity="0.45" TextWrapping="Wrap" TextAlignment="Center"
                                   MaxWidth="440" />
                        <TextBlock x:Name="LabWebHint" HorizontalAlignment="Center"
                                   FontSize="12" Opacity="0.35" TextWrapping="Wrap"
                                   TextAlignment="Center" MaxWidth="440" Margin="0,8,0,0"
                                   Visibility="Collapsed" />
                    </StackPanel>

                    <!-- WebView 宿主：注入样式完成后才显示 -->
                    <Grid x:Name="PanWebHost" Background="{DynamicResource ColorBrushGray8}"
                          Visibility="Collapsed" />

                    <!-- 加载遮罩：不透明，盖住还没处理完的页面，避免用户看到裸样式闪一下 -->
                    <Border x:Name="LoadPageCover"
                            Background="{DynamicResource ColorBrushBackground}"
                            Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <local:MyLoading x:Name="LoadPage" HorizontalAlignment="Center"
                                             Text="{DynamicResource Tools.Wiki.LoadingPage}" />
                            <TextBlock x:Name="LabLoadTip" HorizontalAlignment="Center"
                                       FontSize="12" Opacity="0.4" Margin="0,12,0,0"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       MaxWidth="440"
                                       Text="{DynamicResource Tools.Wiki.PreparingStyle}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </local:MyCard>
    </Grid>
</local:MyPageRight>