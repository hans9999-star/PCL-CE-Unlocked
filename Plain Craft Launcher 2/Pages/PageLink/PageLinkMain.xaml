<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:svgIcon="clr-namespace:PCL.Core.UI.Controls.SvgIcon;assembly=PCL.Core"
    mc:Ignorable="d" x:Class="PCL.PageLinkMain"
    d:DesignWidth="800" d:DesignHeight="800">
    <!-- 分支说明：本页按 PCL2 原版联机界面重做。
         选择页只有「创建房间」「加入房间」两张卡片，点击后弹窗输入（端口 / 邀请码）；
         完成页显示标题（已创建房间 / 已加入房间）、描述（创建时直接写出邀请码）、
         IP / 端口 / 玩家数 / 延迟，以及「复制邀请码」与「关闭 / 离开」。
         后端仍使用 CE 的 LobbyService / Scaffolding / EasyTier 与公开大厅服务器。 -->
    <Grid>
        <!-- 加载卡片 -->
        <Grid x:Name="PanLoad" Visibility="Collapsed">
            <local:MyCard HorizontalAlignment="Center" VerticalAlignment="Center" x:Name="CardLoad"
                          MouseLeftButtonUp="CardLoad_MouseLeftButtonUp"
                          SizeChanged="CardResized">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="25" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="20" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="23" />
                    </Grid.RowDefinitions>
                    <local:MyLoading Grid.Column="1" Grid.Row="1" x:Name="Load" Grid.RowSpan="3" Margin="0,0,0,-30"
                                     HorizontalAlignment="Center"
                                     Text="" TextError="" TextErrorInherit="False" AutoRun="False"
                                     IsHitTestVisible="False" />
                    <TextBlock x:Name="LabLoadTitle" Grid.Column="3" Grid.Row="1" Grid.ColumnSpan="2"
                               VerticalAlignment="Center" Text="{DynamicResource Tools.GameLink.Loading.Creating}"
                               FontSize="19"
                               Margin="0,0,25,1" Foreground="{Binding Foreground, ElementName=Load}"
                               IsHitTestVisible="False" />
                    <TextBlock x:Name="LabLoadDesc" Grid.Column="3" Grid.ColumnSpan="3" Grid.Row="2"
                               VerticalAlignment="Center" Margin="0,5,10,-5"
                               Text="{DynamicResource Tools.GameLink.Loading.DownloadingModule}" FontSize="14"
                               LineHeight="19" MaxWidth="400" MaxHeight="220" TextWrapping="Wrap"
                               Foreground="{StaticResource ColorBrushGray3}" IsHitTestVisible="False" />
                    <local:MyIconButton Grid.Column="5" Grid.Row="1" x:Name="BtnLoadCancel" Height="28" Width="28"
                                        Click="CancelLoad"
                                        VerticalAlignment="Top"
                                        Theme="Black" Opacity="0.5"
                                        ToolTip="{DynamicResource Common.Action.Cancel}"
                                        ToolTipService.Placement="Right"
                                        ToolTipService.InitialShowDelay="100"
                                        LogoScale="0.72"
                                        SvgIcon="lucide/x" />
                    <Grid Height="12" VerticalAlignment="Bottom" Grid.ColumnSpan="100" Grid.RowSpan="100"
                          Margin="0,0,0,-0.6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0*" x:Name="ColumnProgressA" />
                            <ColumnDefinition Width="1*" x:Name="ColumnProgressB" />
                        </Grid.ColumnDefinitions>
                        <Grid.Clip>
                            <RectangleGeometry RadiusX="6" RadiusY="6" x:Name="RectProgressClip" />
                        </Grid.Clip>
                        <Rectangle Fill="{Binding Foreground, ElementName=Load}" VerticalAlignment="Bottom" Height="2" />
                    </Grid>
                </Grid>
            </local:MyCard>
        </Grid>

        <local:MyScrollViewer x:Name="PanContent">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <local:MyHint x:Name="HintAnnounce" Margin="10" MinHeight="36" MaxHeight="64" Grid.Row="0"
                              HorizontalAlignment="Stretch"
                              Text="{DynamicResource Tools.GameLink.Loading.ConnectingServer}" Theme="Blue" />

                <!-- 选择页：两张卡片 -->
                <StackPanel x:Name="PanSelect" Grid.Row="1" HorizontalAlignment="Stretch" Orientation="Vertical">
                    <local:MyCard x:Name="PanSelectCreate" Margin="10"
                                  Title="{DynamicResource Tools.GameLink.Link.CreateTitle}">
                        <StackPanel Margin="12,34,12,12">
                            <TextBlock LineHeight="23" FontSize="14" TextWrapping="Wrap" Margin="10,10,10,2"
                                       Text="{DynamicResource Tools.GameLink.Link.CreateDesc}" />
                            <local:MyButton x:Name="BtnCreate" HorizontalAlignment="Right" Margin="10,8,10,10"
                                            Text="{DynamicResource Tools.GameLink.Link.CreateAction}"
                                            ColorType="Highlight" Padding="16,8" Click="BtnCreate_Click" />
                        </StackPanel>
                    </local:MyCard>

                    <local:MyCard x:Name="PanSelectJoin" Margin="10"
                                  Title="{DynamicResource Tools.GameLink.Link.JoinTitle}">
                        <StackPanel Margin="12,34,12,12">
                            <TextBlock LineHeight="23" FontSize="14" TextWrapping="Wrap" Margin="10,10,10,2"
                                       Text="{DynamicResource Tools.GameLink.Link.JoinDesc}" />
                            <local:MyButton x:Name="BtnJoin" HorizontalAlignment="Right" Margin="10,8,10,10"
                                            Text="{DynamicResource Tools.GameLink.Link.JoinAction}"
                                            ColorType="Highlight" Padding="16,8" Click="BtnJoin_Click" />
                        </StackPanel>
                    </local:MyCard>
                </StackPanel>

                <!-- 完成页 -->
                <Grid x:Name="PanFinish" Visibility="Collapsed" Grid.Row="1">
                    <local:MyCard Margin="10">
                        <StackPanel Margin="16,36,16,16">
                            <TextBlock x:Name="LabFinishTitle" FontSize="19" FontWeight="Bold"
                                       HorizontalAlignment="Center" Margin="0,10,0,8" Text="" />
                            <TextBlock x:Name="LabFinishDesc" FontSize="14" LineHeight="23" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       MaxWidth="460" Margin="10,0,10,16" Text="" />

                            <WrapPanel HorizontalAlignment="Center" Margin="0,2,0,4">
                                <StackPanel x:Name="BtnFinishIp" Orientation="Horizontal" Margin="5"
                                            Background="{StaticResource ColorBrushSemiTransparent}"
                                            ToolTip="{DynamicResource Tools.GameLink.Link.Finish.IpHint}"
                                            ToolTipService.Placement="MousePoint"
                                            MouseLeftButtonUp="BtnFinishIp_MouseLeftButtonUp">
                                    <TextBlock x:Name="LabFinishIp" IsHitTestVisible="False" Margin="12,7"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource ColorBrushGray1}" Text="127.0.0.1" />
                                </StackPanel>
                                <StackPanel x:Name="BtnFinishPort" Orientation="Horizontal" Margin="5"
                                            Background="{StaticResource ColorBrushSemiTransparent}"
                                            ToolTip="{DynamicResource Tools.GameLink.Link.Finish.PortHint}"
                                            ToolTipService.Placement="MousePoint"
                                            MouseLeftButtonUp="BtnFinishPort_MouseLeftButtonUp">
                                    <TextBlock x:Name="LabFinishPort" IsHitTestVisible="False" Margin="12,7"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource ColorBrushGray1}" Text="-" />
                                </StackPanel>
                                <StackPanel x:Name="BtnFinishPlayer" Orientation="Horizontal" Margin="5"
                                            Background="{StaticResource ColorBrushSemiTransparent}"
                                            ToolTip="{DynamicResource Tools.GameLink.Link.Finish.PlayerHint}"
                                            ToolTipService.Placement="MousePoint">
                                    <TextBlock x:Name="LabFinishPlayer" IsHitTestVisible="False" Margin="12,7"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource ColorBrushGray1}" Text="-" />
                                </StackPanel>
                                <StackPanel x:Name="BtnFinishPing" Orientation="Horizontal" Margin="5"
                                            Background="{StaticResource ColorBrushSemiTransparent}"
                                            ToolTip="{DynamicResource Tools.GameLink.Link.Finish.PingHint}"
                                            ToolTipService.Placement="MousePoint">
                                    <TextBlock x:Name="LabFinishPing" IsHitTestVisible="False" Margin="12,7"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource ColorBrushGray1}" Text="-" />
                                </StackPanel>
                            </WrapPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                                <local:MyButton x:Name="BtnFinishCopy" Margin="6,0"
                                                Text="{DynamicResource Tools.GameLink.Link.Finish.CopyCode}"
                                                ColorType="Highlight" Padding="16,8" Click="BtnFinishCopy_Click" />
                                <local:MyButton x:Name="BtnFinishExit" Margin="6,0"
                                                Text="{DynamicResource Tools.GameLink.Link.Finish.Close}"
                                                Padding="16,8" Click="BtnFinishExit_Click" />
                            </StackPanel>
                        </StackPanel>
                    </local:MyCard>
                </Grid>
            </Grid>
        </local:MyScrollViewer>
    </Grid>
</local:MyPageRight>
