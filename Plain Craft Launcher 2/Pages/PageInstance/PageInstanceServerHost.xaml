<local:MyPageRight x:Class="PCL.PageInstanceServerHost"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:local="clr-namespace:PCL"
                   mc:Ignorable="d"
                   PanScroll="{Binding ElementName=PanBack}" Grid.IsSharedSizeScope="True">

    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          x:Name="PanBack">
        <StackPanel Margin="10">

            <!-- 开服配置 -->
            <local:MyCard Margin="10" Title="{DynamicResource Instance.ServerHost.Title}">
                <StackPanel Margin="12,36,12,12">
                    <TextBlock Margin="10,0,10,10" LineHeight="21" FontSize="14" TextWrapping="Wrap"
                               Foreground="{DynamicResource ColorBrushGray2}"
                               Text="{DynamicResource Instance.ServerHost.Description}" />

                    <TextBlock x:Name="LabStatus" Margin="10,0,10,12" FontSize="14" TextWrapping="Wrap"
                               FontWeight="Bold" Foreground="{DynamicResource ColorBrush3}" Text="" />

                    <Grid Margin="10,0,10,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"
                                   Text="{DynamicResource Instance.ServerHost.Port}" />
                        <local:MyTextBox Grid.Row="0" Grid.Column="1" x:Name="TextPort" Text="25565"
                                         HintText="25565" />
                        <TextBlock Grid.Row="0" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,10,0"
                                   Text="{DynamicResource Instance.ServerHost.MaxPlayers}" />
                        <local:MyTextBox Grid.Row="0" Grid.Column="4" x:Name="TextMaxPlayers" Text="20"
                                         HintText="20" />

                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,10,10,0"
                                   Text="{DynamicResource Instance.ServerHost.Memory}" />
                        <local:MyTextBox Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" x:Name="TextMemory"
                                         Text="2048" HintText="2048" />
                        <local:MyCheckBox Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Margin="0,10,0,0"
                                          x:Name="CheckOnlineMode" Checked="True"
                                          Text="{DynamicResource Instance.ServerHost.OnlineMode}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="10,14,10,4">
                        <local:MyButton x:Name="BtnStart" Margin="0,0,12,0" Padding="16,8"
                                        ColorType="Highlight"
                                        Text="{DynamicResource Instance.ServerHost.Start}"
                                        Click="BtnStart_Click" />
                        <local:MyButton x:Name="BtnStop" Padding="16,8"
                                        Text="{DynamicResource Instance.ServerHost.Stop}"
                                        Click="BtnStop_Click" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>

            <!-- 控制台 -->
            <local:MyCard Margin="10" Title="{DynamicResource Instance.ServerHost.Console}">
                <Grid Margin="12,36,12,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="320" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Background="{DynamicResource ColorBrushGray7}" CornerRadius="6">
                        <TextBox x:Name="TextConsole" IsReadOnly="True" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 Background="Transparent" BorderThickness="0" Padding="8"
                                 FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"
                                 Foreground="{DynamicResource ColorBrushGray1}" />
                    </Border>

                    <DockPanel Grid.Row="1" Margin="0,10,0,0">
                        <local:MyButton x:Name="BtnSend" DockPanel.Dock="Right" Margin="10,0,0,0" Padding="16,8"
                                        ColorType="Highlight"
                                        Text="{DynamicResource Instance.ServerHost.Send}"
                                        Click="BtnSend_Click" />
                        <local:MyTextBox x:Name="TextCommand"
                                         HintText="{DynamicResource Instance.ServerHost.CommandHint}"
                                         MaxLines="1" AcceptsReturn="False"
                                         KeyDown="TextCommand_KeyDown" />
                    </DockPanel>
                </Grid>
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
